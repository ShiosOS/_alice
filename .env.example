# Server-only / sensitive
DATABASE_URL=postgresql://user:pass@localhost:5432/alice
NUXT_DATABASE_URL=postgresql://user:pass@localhost:5432/alice
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters-long
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Optional explicit redirect (prod):
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://alice.shiosos.dev/auth/google
NUXT_YOUTUBE_API_KEY=
NUXT_AI_API_KEY=
# Match key vendor: OpenAI → api.openai.com; OpenRouter (sk-or-…) → openrouter.ai
NUXT_AI_BASE_URL=https://openrouter.ai/api/v1
NUXT_AI_MODEL=openai/gpt-4o-mini
NUXT_EXPAND_DAILY_BUDGET=50
NUXT_EXPAND_DISABLED=false
NUXT_SENTRY_DSN=

# Public
NUXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NUXT_PUBLIC_APP_URL=https://alice.shiosos.dev

# PR integration tests only — when 1/true, YouTube/AI services return fixtures
# NUXT_TEST_FIXTURES=1
